# Server
# Interface to bind. Use 0.0.0.0 inside a container; 127.0.0.1 keeps it local.
BIND_ADDR=127.0.0.1
PORT=8082
WORKERS=4

# Database
# Relative paths resolve against the working directory.
DB_PATH=data/AnimeData.db
DB_POOL_SIZE=8

# Frontend directory containing index.html, anime.html and static/
FRONTEND_DIR=frontend

# Comma-separated list of origins allowed by CORS, or * for any.
# The Android client is not a browser origin, so the default is fine.
CORS_ORIGINS=*
MAX_PER_PAGE=100

# Catalogue sync
# 1 = start the loaders on boot, 0 = serve the API only.
LOADERS_ON_START=1
# Rows per upstream request. AniList allows 50.
SYNC_PAGE_SIZE=50
# How many titles get characters and staff fetched from Kitsu (2 requests
# each). 0 disables the stage. Raise it gradually: Kitsu is a free API.
KITSU_ENRICH_LIMIT=2000
# Optional AniList OAuth client id. Supplying one raises the rate limit from
# 30 to 90 requests per minute, which is the single biggest speed-up available.
# ANILIST_CLIENT_ID=

# Token required by POST /api/sync/start and /api/sync/abort.
# Leave unset to disable those endpoints entirely.
# SYNC_ADMIN_TOKEN=change-me

# Outbound request behaviour
UPSTREAM_TIMEOUT_SECS=45
