# Build output
/target/
**/*.rs.bk

# Runtime data. The catalogue is a rebuildable cache of public APIs, so it is
# never committed; the legacy v1 database names are listed too so an existing
# checkout does not start tracking one by accident.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.legacy-*

# Local secrets
.env
.env.local
*.keystore
*.jks
keystore.properties

# Mobile build artefacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
*.aab.idx

# Android signing material must never be committed
android/keystores/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
