# Build output
/target/
**/*.rs.bk

# Runtime data. The catalogue is a rebuildable cache of public APIs, so it is
# never committed; the legacy v1 database names are listed too so an existing
# checkout does not start tracking one by accident.
#
# Leading slash on purpose: a bare `data/` matches every directory with that
# name at any depth, which silently excluded the Android app's
# `ru/teivrim/anime/data/` package - the whole data layer - from the repository.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.legacy-*

# Local secrets
.env
.env.local
*.keystore
*.jks
keystore.properties

# Mobile build artefacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
*.aab.idx

# Android signing material must never be committed. The .example file is the
# only thing in there that belongs in the repository: it documents the keys
# without carrying any of them.
android/keystores/*
!android/keystores/keystore.properties.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
