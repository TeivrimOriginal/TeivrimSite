# Template for tools/make-keystore.ps1. Never commit the real file.
#
# Copy this file to keystores/keystore.properties and fill it in, or just run
# the script, which writes it for you:
#
#   powershell -File tools\make-keystore.ps1
#
# Gradle reads it through loadKeystoreProperties() in app/build.gradle.kts. A
# missing file is not an error: the build falls back to an unsigned bundle, so a
# fresh clone still compiles.
#
# The file must be UTF-8 without a BOM - java.util.Properties.load does not
# strip one, and a BOM would turn the first key into "<BOM>storeFile".
#
# storeFile      path to the .jks, relative to the repository root
# storePassword  keystore password
# keyAlias       key alias
# keyPassword    key password (may equal storePassword)
# apiBaseUrl     base URL the release build talks to; must be https:// in
#                production, because cleartext is blocked by the network
#                security config
storeFile=android/keystores/anime-release.jks
storePassword=
keyAlias=anime
keyPassword=
apiBaseUrl=https://anime.teivrim.ru/
