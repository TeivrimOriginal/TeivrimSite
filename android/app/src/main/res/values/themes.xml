<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theme, so this only has to make the window
      itself match before the first frame is drawn. Without the dark variant
      the app flashes white on a dark device at every cold start.
    -->
    <style name="Theme.AnimeDb" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
